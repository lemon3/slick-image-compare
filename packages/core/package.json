{
  "name": "slick-image-compare",
  "version": "0.4.13",
  "packageManager": "pnpm@12.11.2",
  "description": "before and after image comparison slider",
  "author": "wolfgang jungmayer",
  "license": "MIT",
  "browser": "dist/slick-image-compare.umd.js",
  "type": "module",
  "main": "dist/slick-image-compare.umd.js",
  "module": "./dist/slick-image-compare.js",
  "style": "./dist/slick-image-compare.css",
  "exports": {
    ".": {
      "import": "./dist/slick-image-compare.js",
      "require": "./dist/slick-image-compare.umd.js"
    },
    "./react": {
      "import": "./../react/dist/index.js",
      "require": "./../react/dist/index.umd.js"
    },
    "./style": "./dist/slick-image-compare.css",
    "./dist/*.css": "./dist/*.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "docs": "vite build --config vite.config.pages.js && mv ../../docs/docs.html ../../docs/index.html",
    "docs:preview": "npm run docs && vite preview --config vite.config.pages.js",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.js'",
    "lint:fix": "eslint --fix 'src/**/*.js'",
    "format": "prettier --check 'src/**/*.js'",
    "format:fix": "prettier --write 'src/**/*.js'",
    "test": "vitest",
    "bench": "vitest bench",
    "coverage": "vitest --coverage"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "index.js"
  ],
  "keywords": [
    "slick-image-compare",
    "beforeafter",
    "before-after",
    "before-after-slider",
    "images",
    "slider",
    "compare",
    "compare-slider",
    "compare-viewer",
    "comparison",
    "comparison-slider",
    "comparison-viewer",
    "image-compare",
    "image-compare-viewer",
    "image-compare-slider",
    "image-comparison",
    "image-comparison-slider",
    "image-comparison-viewer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemon3/slick-image-compare.git"
  },
  "homepage": "https://lemon3.github.io/slick-image-compare",
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "postcss-nested": "^9.0.0",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-banner": "^0.8.1",
    "vitest": "^5.0.5"
  }
}
